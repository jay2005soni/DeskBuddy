{
  "name": "deskbuddy-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "build": "node scripts/check-js.mjs",
    "start": "node src/server.js",
    "test": "vitest run --exclude tests/integration.test.js",
    "test:integration": "vitest run tests/integration.test.js",
    "test:emulators": "node scripts/emulators.mjs",
    "emulators": "node scripts/emulators.mjs --start",
    "contract": "node validate-contract.mjs && redocly lint openapi.json",
    "check": "npm run build && npm run contract && npm test"
  },
  "dependencies": {
    "express": "5.3.0",
    "firebase-admin": "14.5.0",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "2.71.0",
    "firebase-tools": "15.34.1",
    "supertest": "7.3.1",
    "vitest": "5.0.5"
  }
}

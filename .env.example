# Copy to .env for local emulator development. No real credentials needed here.
NODE_ENV=development
PORT=8080
FIREBASE_PROJECT_ID=demo-deskbuddy
FIREBASE_WEB_API_KEY=demo-api-key
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
CURSOR_SECRET=local-only-change-this-32-character-secret
TRUST_PROXY_HOPS=0
# Staging: remove BOTH emulator variables, use a real project/key and random secret.
# NODE_ENV=production
# TRUST_PROXY_HOPS=1
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/firebase-service-account.json
# Production should use ADC / a dedicated workload service account instead of a key file.

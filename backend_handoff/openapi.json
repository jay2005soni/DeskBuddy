  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase ID token"
      }
    },
    "schemas": {
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "emailVerified": {
            "type": "boolean"
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "uid",
          "displayName",
          "email",
          "emailVerified",
          "timezone",
          "createdAt",
          "updatedAt"
        ]
      },
      "Preferences": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "focusMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          },
          "breakMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "breathingSeconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 180
          },
          "notificationForwardingEnabled": {
            "type": "boolean"
          },
          "notificationApps": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 255,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "focusMinutes",
          "breakMinutes",
          "breathingSeconds",
          "notificationForwardingEnabled",
          "notificationApps",
          "updatedAt"
        ]
      },
      "PreferencesPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "focusMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          },
          "breakMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },

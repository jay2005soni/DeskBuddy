# Backend only. Use a NEW staging Firebase project, never production secrets here.
PORT=8080
FIREBASE_PROJECT_ID=replace-with-project-id
FIREBASE_WEB_API_KEY=replace-with-project-web-api-key
# Local development: point to a private file OUTSIDE the repository.
# Production: prefer workload identity / Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=C:/private/firebase-service-account.json
NODE_ENV=development
# Emulator-only variables. Never set on production deployments.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
